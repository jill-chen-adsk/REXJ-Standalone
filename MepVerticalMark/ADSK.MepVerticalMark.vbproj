<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>ADSK.MepVerticalMark</RootNamespace>
    <AssemblyName>ADSK.MepVerticalMark</AssemblyName>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>REVIT2027</DefineConstants>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Text</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <MyType>Windows</MyType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Import Include="ADSK.MepVerticalMark" />
    <Import Include="ADSK.MepVerticalMark.My" />
    <Import Include="ADSK.MepVerticalMark.My.Resources" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="App.vb" />
    <Compile Include="Forms\LevelSelectionForm.vb" />
    <Compile Include="MEPVerticalMark\CmdVerticalDuctMark.vb" />
    <Compile Include="MEPVerticalMark\CmdVerticalPipeMark.vb" />
    <Compile Include="MEPVerticalMark\DlgMarkType.designer.vb">
      <DependentUpon>DlgMarkType.vb</DependentUpon>
    </Compile>
    <Compile Include="MEPVerticalMark\DlgMarkType.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MEPVerticalMark\DlgSelectFamily.Designer.vb">
      <DependentUpon>DlgSelectFamily.vb</DependentUpon>
    </Compile>
    <Compile Include="MEPVerticalMark\DlgSelectFamily.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="My Project\Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Include="My Project\AssemblyInfo.vb" />
    <Compile Include="My Project\Res.vb" />
    <Compile Include="My Project\Resources.Designer.vb">
      <AutoGen>False</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="My Project\Settings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <Compile Include="SelectionFilter\SelFiltNominated.vb" />
    <Compile Include="SelectionFilter\SelFiltVerticalDuct.vb" />
    <Compile Include="SelectionFilter\SelFiltVerticalPipe.vb" />
    <Compile Include="Sorter\CmpDuctByCoordX.vb" />
    <Compile Include="Sorter\CmpDuctByCoordY.vb" />
    <Compile Include="Sorter\cmpLevel.vb" />
    <Compile Include="Sorter\CmpPipeByCoordX.vb" />
    <Compile Include="Sorter\CmpPipeByCoordY.vb" />
    <Compile Include="Utils\EnumMembers.vb" />
    <Compile Include="Utils\Logger.vb" />
    <Compile Include="Utils\mdlUtils.vb" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MEPVerticalMark\DlgMarkType.resx">
      <DependentUpon>DlgMarkType.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="MEPVerticalMark\DlgSelectFamily.resx">
      <DependentUpon>DlgSelectFamily.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <SubType>Designer</SubType>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Include="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\VerticalMark1.png" />
    <EmbeddedResource Include="Resources\VerticalMark0.png" />
    <EmbeddedResource Include="Resources\ICON_LARGE_YABANE_DUCT.png" />
    <EmbeddedResource Include="Resources\ICON_LARGE_YABANE_PIPE.png" />
    <EmbeddedResource Include="Resources\ICON_SMALL_YABANE_DUCT.png" />
    <EmbeddedResource Include="Resources\ICON_SMALL_YABANE_PIPE.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\RME 矢羽配管・ダクト.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ADSK.MepVerticalMark.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="@(RfaFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>
  <ItemGroup>
    <RfaFiles Include="rfa2026\*.rfa" />
  </ItemGroup>

</Project>
