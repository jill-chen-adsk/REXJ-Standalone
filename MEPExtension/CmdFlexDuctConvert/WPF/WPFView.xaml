<Window x:Class="WPFView.WPF.WPFView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFView.WPF"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Flexible Duct Length Setting" Height="220.821" Width="267.449" WindowStartupLocation="CenterOwner">
    <Grid>
        <Button x:Name="button_Ok" 
                Content="Ok" 
                HorizontalAlignment="Left" 
                Margin="57,144,0,0" 
                VerticalAlignment="Top" 
                Width="75"
                Command="{Binding _btn_WPFViewModelOK}"/>
        <Button x:Name="button_Cancel" 
                Content="Cancel" 
                HorizontalAlignment="Left" 
                Margin="150,144,0,0" 
                VerticalAlignment="Top" 
                Width="75"
                Command="{Binding _btn_WPFViewModelCancel}"/>
        <TextBox x:Name="textBox01" 
                 HorizontalAlignment="Left" 
                 Height="23" 
                 Margin="57,66,0,0" 
                 TextWrapping="Wrap" 
                 VerticalAlignment="Top" 
                 Width="120"
                 Text="{Binding _txt_WPFViewModel001,Mode=TwoWay}"/>
        <Label x:Name="label01" 
               Content="Flexible Duct Length" 
               HorizontalAlignment="Left" 
               Height="27" 
               Margin="32,24,0,0" 
               VerticalAlignment="Top" 
               Width="134"/>
        <Label x:Name="label02" 
               Content="mm" 
               HorizontalAlignment="Left" 
               Height="23" 
               Margin="177,66,0,0" 
               VerticalAlignment="Top" 
               Width="34"/>
    </Grid>
</Window>
