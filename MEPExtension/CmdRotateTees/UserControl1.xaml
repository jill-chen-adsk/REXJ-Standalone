<UserControl x:Class="CmdRotateTees.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CmdRotateTees"
             mc:Ignorable="d" Height="106.271" Width="84.643"
             >
    <Grid Margin="0,0,0.8,-5.8" Height="101" VerticalAlignment="Top">
        <Button x:Name="btnRotateMinus45" Click="Click_RotateMinus" Content="←" HorizontalAlignment="Left" Margin="0,26,0,0" VerticalAlignment="Top" Width="39" RenderTransformOrigin="-0.183,0.637"/>
        <Button x:Name="btnRotate45" Click="Click_RotatePlus" Content="→" HorizontalAlignment="Left" Margin="44,26,0,0" VerticalAlignment="Top" Width="38"/>
        <Button x:Name="btnRest" Click="Click_Rest" Content="Reset" HorizontalAlignment="Left" Margin="0,85,0,-2" Width="82" RenderTransformOrigin="-0.183,0.637" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="txtAngle" HorizontalAlignment="Left" Height="23" Margin="22,0,0,0" TextWrapping="Wrap" Text="45" VerticalAlignment="Top" Width="40"/>
        <TextBlock x:Name="Label1" HorizontalAlignment="Left" Margin="67,1,0,0" TextWrapping="Wrap" Text="°" VerticalAlignment="Top" RenderTransformOrigin="1.424,1.122"/>
        <Button x:Name="btnChangeConnector" Click="Click_btnChangeConnector" Content="Change Axis" HorizontalAlignment="Left" Margin="0,47,0,0" Width="82" RenderTransformOrigin="-0.183,0.637" Height="18" VerticalAlignment="Top"/>
        <Button x:Name="btnCommit" Click="Click_btnCommit" Content="OK" HorizontalAlignment="Left" Margin="0,66,0,0" Width="82" RenderTransformOrigin="-0.183,0.937" Height="18" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
