<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DockContainerStackPanel" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Visibility" Value="Visible" />
    </Style>
    <Style x:Key="DockLabel" TargetType="Label">
        <Setter Property="Width" Value="70" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="DockCheckbox" TargetType="CheckBox">
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Margin" Value="0 3 0 0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="DockCombobox" TargetType="ComboBox">
        <Setter Property="Width" Value="200" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Margin" Value="0 0 0 2" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="DockToggleButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="60" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Margin" Value="0 0 0 2" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="HR" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="LightGray" />
        <Setter Property="Margin" Value="4 0 4 0" />
    </Style>
    <Style x:Key="EnclosureBorder" TargetType="Border">
        <!-- BorderBrush="LightGray" BorderThickness="1" Padding="5" Margin="0" -->
        <!-- <Setter Property="Height" Value="2" /> -->
        <Setter Property="BorderBrush" Value="LightGray" />
        <Setter Property="BorderThickness" Value="1 " />
        <Setter Property="Margin" Value="4 0 4 0" />
        <Setter Property="Padding" Value="5" />
    </Style>
</ResourceDictionary>