<Window x:Class="REXJManager.TabSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:REXJManager"
        mc:Ignorable="d"
        Title="Ribbon tab visibility" Height="780" Width="300"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Closing="TabSettingWindow_OnClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <TextBlock Visibility="Visible">
                <TextBlock.ContextMenu>
                    <ContextMenu >
                        <MenuItem Header="About" Click="MenuItem_Info_OnClick"/>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
            <ComboBox Grid.Column="1" x:Name="PresetComboBox" ToolTip="Choose a preset.&#xa;Built-in presets are read-only.&#xa;Duplicate or create a new preset to customize which ribbon items are shown." BorderBrush="Gray" SelectionChanged="PresetComboBox_OnSelectionChanged" Visibility="Visible" />
            <TextBox Grid.Column="1" x:Name="PresetNameTextBox" Visibility="Visible" KeyDown="PresetNameTextBox_OnKeyDown" />
            <Button Grid.Column="2" x:Name="TrashButton" ToolTip="Delete preset" Click="TrashButton_OnClick" Margin="0 -4 2 0 " Padding="0" BorderThickness="0" Background="Transparent" FontSize="20">
                <Image Source="../Res/TrashBox.png" Width="21" Margin="0 4 0 0 " />
            </Button>
            <Button Grid.Column="3" x:Name="DuplicateButton" ToolTip="Duplicate preset" Click="DuplicateButton_OnClick" Margin="0 -4 2 0 " BorderThickness="0" Background="Transparent" FontSize="20">
                <Image Source="../Res/Duplicate.png" Width="21" Margin="0 4 0 0 " />
            </Button>
            <Button Grid.Column="4" x:Name="AddPresetButton" ToolTip="New preset" Margin="0 -6 2 0 " Click="AddPresetButton_OnClick" BorderThickness="0" Background="Transparent" Content="+" FontSize="20" />
        </Grid>

        <TreeView Grid.Row="1" x:Name="TabTreeView" Margin="1 2 1 1">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:MyTreeNode}" ItemsSource="{Binding Children }">
                    <CheckBox x:Name="ChkBox" IsChecked="{Binding IsChecked }" Click="CheckBox_OnClick" IsEnabled="{Binding IsEnabled }">
                        <TextBlock Text="{Binding Path=Name}" />
                    </CheckBox>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Window>
