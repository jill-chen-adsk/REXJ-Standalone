<Window x:Class="ADSK.JExtRAC.ParameterFilter.UI.FormParameterFilterWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Filter"
        Height="440"
        Width="960"
        MinWidth="950"
        MinHeight="435"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.ParameterFilter;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{DynamicResource Weave.Brush.Chrome.CloseHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <TabControl x:Name="tabParameterFilter"
                        Grid.Row="2"
                        Style="{StaticResource Weave.TabControl}"
                        Margin="12,12,12,0"
                        SelectionChanged="TabParameterFilter_SelectionChanged"
                        PreviewMouseDown="TabParameterFilter_PreviewMouseDown">
                <TabItem x:Name="tabPageCategory" Header="Category">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgvCategory"
                                  Grid.Row="0"
                                  Style="{StaticResource Weave.DataGrid}"
                                  ColumnHeaderStyle="{StaticResource Weave.DataGridColumnHeader}"
                                  CellStyle="{StaticResource Weave.DataGridCell}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" MinWidth="40" CanUserResize="False"
                                                        HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Checkbox}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="FilterRowCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="colCategoryName" Binding="{Binding Name}" Width="*" MinWidth="120" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colCategoryCount" Binding="{Binding Count}" Width="96" MinWidth="96" IsReadOnly="True"
                                                    CanUserResize="True"
                                                    HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Count}"
                                                    CellStyle="{StaticResource Weave.DataGridCell.Count}"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblCountTypeCategory" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblCounterCategory" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblCountObjCate" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblObjCounterCategory" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <Button x:Name="btnSelectAllCategory" Grid.Column="3"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Margin="0,0,8,0" Click="BtnSelectAllCategory_Click"/>
                            <Button x:Name="btnSelectClearCategory" Grid.Column="4"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Click="BtnSelectClearCategory_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabPageFamily" Header="Family">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgvFamily"
                                  Grid.Row="0"
                                  Style="{StaticResource Weave.DataGrid}"
                                  ColumnHeaderStyle="{StaticResource Weave.DataGridColumnHeader}"
                                  CellStyle="{StaticResource Weave.DataGridCell}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" MinWidth="40" CanUserResize="False"
                                                        HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Checkbox}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="FilterRowCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="colFamilyCategory" Binding="{Binding SubName}" Width="*" MinWidth="100" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colFamilyName" Binding="{Binding Name}" Width="*" MinWidth="100" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colFamilyCount" Binding="{Binding Count}" Width="96" MinWidth="96" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Count}"
                                                    CellStyle="{StaticResource Weave.DataGridCell.Count}"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblCountTypeFamily" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblTypeCounterFamily" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblCountObjectFamily" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblObjectCounterFamily" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <Button x:Name="btnSelectAllFamily" Grid.Column="3"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Margin="0,0,8,0" Click="BtnSelectAllFamily_Click"/>
                            <Button x:Name="btnSelectClearFamily" Grid.Column="4"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Click="BtnSelectClearFamily_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabPageFamilyType" Header="Family Type">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgvFamilyType"
                                  Grid.Row="0"
                                  Style="{StaticResource Weave.DataGrid}"
                                  ColumnHeaderStyle="{StaticResource Weave.DataGridColumnHeader}"
                                  CellStyle="{StaticResource Weave.DataGridCell}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single"
                                  Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" MinWidth="40" CanUserResize="False"
                                                        HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Checkbox}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="FilterRowCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="colFtCategory" Binding="{Binding SubName}" Width="*" MinWidth="100" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colFtName" Binding="{Binding Name}" Width="*" MinWidth="100" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colFtCount" Binding="{Binding Count}" Width="96" MinWidth="96" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Count}"
                                                    CellStyle="{StaticResource Weave.DataGridCell.Count}"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblCountTypeFamilyType" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblTypeCounterFamilyType" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblCountObjectFamilyType" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblObjectCounterFamilyType" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <Button x:Name="btnSelectAllFamilyType" Grid.Column="3"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Margin="0,0,8,0" Click="BtnSelectAllFamilyType_Click"/>
                            <Button x:Name="btnSelectClearFamilyType" Grid.Column="4"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Click="BtnSelectClearFamilyType_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabPageParameter" Header="Parameter">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,8">
                            <CheckBox x:Name="cbkSelectConnect"
                                      Style="{StaticResource Weave.CheckBox}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>
                            <Button x:Name="btnSettingParameterGroup"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Click="BtnSettingParameterGroup_Click"/>
                        </StackPanel>
                        <DataGrid x:Name="dgvParameter"
                                  Grid.Row="1"
                                  Style="{StaticResource Weave.DataGrid}"
                                  ColumnHeaderStyle="{StaticResource Weave.DataGridColumnHeader}"
                                  CellStyle="{StaticResource Weave.DataGridCell}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single"
                                  Margin="0,0,0,0">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource Weave.DataGridRow}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" MinWidth="40" CanUserResize="False"
                                                        HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Checkbox}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Click="ParameterRowCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="colParamCategory" Binding="{Binding Category}" Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colParamFamilyType" Binding="{Binding FamilyType}" Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colParamName" Binding="{Binding ParameterName}" Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTemplateColumn x:Name="colParamValue" Header="Value" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     IsReadOnly="{Binding ValueReadOnly}"
                                                     Style="{StaticResource Weave.TextBox}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="colParamMin" Header="Min" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Min, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     IsReadOnly="{Binding MinReadOnly}"
                                                     Style="{StaticResource Weave.TextBox}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="~" Width="30" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="~" Style="{StaticResource Weave.DataGridTextBlock}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="colParamMax" Header="Max" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Max, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     IsReadOnly="{Binding MaxReadOnly}"
                                                     Style="{StaticResource Weave.TextBox}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="colParamError" Binding="{Binding Error}" Width="20" MinWidth="20" MaxWidth="120"
                                                    Header="" Visibility="Collapsed" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Left}"/>
                                <DataGridTextColumn x:Name="colParamCount" Binding="{Binding CountDisplay}" Width="96" MinWidth="96" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource Weave.DataGridColumnHeader.Count}"
                                                    CellStyle="{StaticResource Weave.DataGridCell.Count}"
                                                    ElementStyle="{StaticResource Weave.DataGridTextBlock.Count}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblCountTypeParameter" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblTypeCounterTypeParameter" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblCountObjectTypeParameter" Style="{StaticResource Weave.HintText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblObjectCounterTypeParameter" FontWeight="Bold" Style="{StaticResource Weave.BodyText}"/>
                            </StackPanel>
                            <Button x:Name="btnSelectAllParameter" Grid.Column="3"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Margin="0,0,8,0" Click="BtnSelectAllParameter_Click"/>
                            <Button x:Name="btnSelectClearParameter" Grid.Column="4"
                                    Style="{StaticResource Weave.Button.Secondary}"
                                    Click="BtnSelectClearParameter_Click"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border x:Name="footerDivider" Grid.Row="3" Background="{DynamicResource Weave.Brush.Border}"/>

            <Border x:Name="footerBorder" Grid.Row="4" Padding="20,12,20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnPrevious"
                            Style="{StaticResource Weave.Button.Tertiary}"
                            Margin="0,0,8,0"
                            Click="BtnPrevious_Click"/>
                    <Button x:Name="btnNext"
                            Style="{StaticResource Weave.Button.Tertiary}"
                            Margin="0,0,8,0"
                            Click="BtnNext_Click"/>
                    <Button x:Name="btnPreview"
                            Style="{StaticResource Weave.Button.Tertiary}"
                            Margin="0,0,8,0"
                            Click="BtnPreview_Click"/>
                    <Button x:Name="btnCancel"
                            Style="{StaticResource Weave.Button.Secondary}"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="btnOk"
                            Style="{StaticResource Weave.Button.Primary}"
                            IsDefault="True"
                            Click="BtnOk_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
