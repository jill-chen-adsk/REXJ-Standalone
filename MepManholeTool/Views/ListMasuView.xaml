<Window x:Class="MepManholeTool.Views.ListMasuView"
      x:Name="ListMasuWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:viewModel1="clr-namespace:MepManholeTool.ViewModel"
      mc:Ignorable="d"
      Title="Selected Manhole List" Height="500" MinHeight="500" MinWidth="255" Width="255" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModel1:ManholeViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary Source="UIStyle.xaml" />
    </Window.Resources>
    <Grid Background="#f0f0f0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0">
            <Border BorderBrush="Aqua" BorderThickness="1" Padding="5" Margin="5">
            <StackPanel>
                <StackPanel.Background>
                    <SolidColorBrush Color="#FFFBEAEA" Opacity="0.25"/>
                </StackPanel.Background>
                <Label>Base Level</Label>
                <ComboBox Width="auto" ItemsSource="{Binding Levels}" Height="30" SelectedItem="{Binding CurrentLevel}"/>
            </StackPanel>
            </Border>
        </Grid>
        
        <Grid Grid.Row="1">
            <Border BorderBrush="Aqua" BorderThickness="1" Padding="5" Margin="5">
                <WrapPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Grid.Row="0">Tag</Label>
                        <ComboBox x:Name="MasuTagFamilyComboBox" Grid.Column="0" Grid.Row="1" Height="30" Visibility="Visible"
                                  ItemsSource="{Binding SymbolPairs}" DisplayMemberPath="Value" SelectedValuePath="Key" 
                                  SelectedItem="{Binding SelectedSymbol, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                                  Loaded="MasuTagFamilyComboBox_Loaded">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <Trigger Property="Validation.HasError" Value="True">
                                            <Setter Property="BorderBrush" Value="Red"/>
                                            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Button x:Name="ImportButton" Grid.Column="2" Grid.Row="1" Content="Import" Width="50" Height="30" Command="{Binding ImportCommand}" Background="White" BorderBrush="LightGray" BorderThickness="1" />
                    </Grid>
                </WrapPanel>
            </Border>
        </Grid>
        
        <Grid Grid.Row="2" Grid.Column="0">
            <Border BorderBrush="Aqua" BorderThickness="1" Padding="5" Margin="5">
                <WrapPanel>
                    <Label>Reorder manholes (top = upstream)</Label>
                    <DataGrid x:Name="ListMasuGrid" Width="150" Height="150" ItemsSource="{Binding MasuItems, Mode=TwoWay}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="True" SelectionMode="Single"
                              IsReadOnly="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              SelectedIndex="{Binding CurrentIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              CanUserSortColumns="False" Background="White" RowHeaderWidth="0" BorderThickness="0" GridLinesVisibility="None"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="AliceBlue" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey }" Color="Black" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="AliceBlue" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Manhole No." Binding="{Binding MasuSymbol}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Left" Width="auto" VerticalAlignment="Bottom" Margin="10 0">
                        <Button x:Name="ResetButton" Content="Reset" Width="40" Height="30" Command="{Binding ResetCommand}" Background="White" BorderBrush="LightGray" BorderThickness="1" Margin="2"/>
                        <Button x:Name="UpButton" Content="↑" Width="40" Height="30" FontFamily="MS Gothic" FontSize="18" FontWeight="ExtraBold" Command="{Binding UpCommand}" Background="White" BorderBrush="LightGray" BorderThickness="1" Margin="2"/>
                        <Button x:Name="DownButton" Content="↓" Width="40" Height="30" FontFamily="MS Gothic" FontSize="18" FontWeight="ExtraBold" Command="{Binding DownCommand}" Background="White" BorderBrush="LightGray" BorderThickness="1" Margin="2"/>
                        <Button x:Name="RemoveButton" Content="Delete" Width="40" Height="30" Command="{Binding RemoveCommand}" Background="White" BorderBrush="LightGray" BorderThickness="1" Margin="2 2 2 0"/>                
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Left" Margin="0 10">
                        <Label>Manhole verification view</Label>
                        <ComboBox Name="CreateViewMode" SelectedIndex="{Binding CreateViewMode, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Background="White" BorderBrush="LightGray" BorderThickness="1">
                            <ComboBoxItem Content="Create New" FontSize="12" VerticalContentAlignment="Center" Background="White"/>
                            <ComboBoxItem Content="Use Existing" FontSize="12" VerticalContentAlignment="Center" Background="White"/>
                            <ComboBoxItem Content="Skip" FontSize="12" VerticalContentAlignment="Center" Background="White"/>
                        </ComboBox>
                    </WrapPanel>
                </WrapPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="NextButton" Content="Next" Width="50" Height="30" Command="{Binding NextCommand}" Background="White" BorderBrush="LightGray" BorderThickness="1" Margin="5"/>
        </DockPanel>
    </Grid>
</Window>