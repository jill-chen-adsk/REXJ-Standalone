<Window x:Class="ADSK.JExtRAC.FittingSchedule.Components.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing"
        Width="480" Height="120"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">
    <Border x:Name="outerBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="#000000" />
        </Border.Effect>
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="titleText" Grid.Row="0"
                       Text="Processing..."
                       FontSize="14" FontWeight="SemiBold"
                       FontFamily="ArtifaktElement, Segoe UI, sans-serif" />

            <!-- Status label -->
            <TextBlock x:Name="statusText" Grid.Row="2"
                       Text=""
                       FontSize="12" FontWeight="Normal"
                       FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                       TextTrimming="CharacterEllipsis" />

            <!-- Progress bar track (4px, capsule-shaped per Weave spec) -->
            <Border x:Name="progressTrack" Grid.Row="4"
                    Height="4" CornerRadius="2"
                    HorizontalAlignment="Stretch">
                <!-- Progress bar fill -->
                <Border x:Name="progressFill"
                        Height="4" CornerRadius="2"
                        HorizontalAlignment="Left" Width="0">
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
