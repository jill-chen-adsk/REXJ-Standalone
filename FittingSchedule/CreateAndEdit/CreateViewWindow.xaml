<Window x:Class="ADSK.JExtRAC.FittingSchedule.CreateAndEdit.CreateViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Create doors and windows view"
        Width="480" Height="520"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True">
    <Border x:Name="outerBorder" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- WPF Title Bar - handles drag -->
            <Grid x:Name="titleBarGrid" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="titleText" Text="Create doors and windows view"
                           FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <Button x:Name="btnClose" Click="BtnClose_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Width="28" Height="28"
                        Background="Transparent" BorderBrush="Transparent"
                        Foreground="#888888"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="16" Height="16" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Heavy divider -->
            <Border x:Name="dividerBorder" Grid.Row="1" />

            <!-- WebView2 content area -->
            <wv2:WebView2 Grid.Row="2" x:Name="webView"
                          DefaultBackgroundColor="Transparent" />
        </Grid>
    </Border>
</Window>
