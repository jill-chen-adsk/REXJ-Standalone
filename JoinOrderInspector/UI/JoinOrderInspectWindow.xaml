<Window x:Class="ADSK.JExtRAC.JoinOrderInspector.UI.JoinOrderInspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Order Inspector"
        Width="820"
        MinWidth="640"
        Height="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.JoinOrderInspector;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{DynamicResource Weave.Brush.Chrome.CloseHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,16,24,8">
                <Border Style="{StaticResource Weave.LegendChip}"
                        Background="{DynamicResource Weave.Brush.Legend.Selected}"
                        BorderBrush="{DynamicResource Weave.Brush.Legend.Selected.Border}">
                    <TextBlock x:Name="legendSelected" FontWeight="SemiBold" Style="{StaticResource Weave.LegendChip.Text}"/>
                </Border>
                <Border Style="{StaticResource Weave.LegendChip}"
                        Background="{DynamicResource Weave.Brush.Legend.Cutting}"
                        BorderBrush="{DynamicResource Weave.Brush.Legend.Cutting.Border}">
                    <TextBlock x:Name="legendCutting" Style="{StaticResource Weave.LegendChip.Text}"/>
                </Border>
                <Border Style="{StaticResource Weave.LegendChip}"
                        Background="{DynamicResource Weave.Brush.Legend.CutBy}"
                        BorderBrush="{DynamicResource Weave.Brush.Legend.CutBy.Border}">
                    <TextBlock x:Name="legendCutBy" Style="{StaticResource Weave.LegendChip.Text}"/>
                </Border>
            </StackPanel>

            <ListView x:Name="elementListBox"
                      Grid.Row="3"
                      Margin="24,0,24,0"
                      Style="{StaticResource Weave.ListView}"
                      ItemContainerStyle="{StaticResource Weave.ListViewItem}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding Id}"
                                    MinWidth="72"
                                    Height="28"
                                    Margin="0,0,10,0"
                                    Padding="8,0"
                                    Click="Element_Button_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Weave.Button.Secondary}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Id}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Info}"
                                       Style="{StaticResource Weave.ListViewTextBlock}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button x:Name="btnReanalyze"
                    Grid.Row="4"
                    Style="{StaticResource Weave.Button.Secondary}"
                    HorizontalAlignment="Left"
                    Margin="24,12,24,24"
                    Click="BtnReanalyze_Click"/>
        </Grid>
    </Border>
</Window>
