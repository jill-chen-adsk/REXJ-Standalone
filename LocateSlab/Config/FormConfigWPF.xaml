<Window x:Class="ADSK.JExtRAC.LocateSlab.Config.FormConfigWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormConfig"
        Width="460"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.LocateSlab;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{DynamicResource Weave.Brush.Chrome.CloseHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <Grid Grid.Row="2" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblSlabType"
                               Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource Weave.BodyText}"
                               Margin="0,0,16,12"/>
                    <ComboBox x:Name="cboSlabType"
                              Grid.Row="0"
                              Grid.Column="1"
                              Style="{StaticResource Weave.ComboBox}"
                              Margin="0,0,0,12"/>

                    <TextBlock x:Name="lblHeightOffset"
                               Grid.Row="1"
                               Grid.Column="0"
                               Style="{StaticResource Weave.BodyText}"
                               VerticalAlignment="Top"
                               Margin="0,6,16,12"/>
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtHeightOffset"
                                     Width="120"
                                     Style="{StaticResource Weave.TextBox}"
                                     TextAlignment="Right"
                                     PreviewTextInput="TxtHeightOffset_PreviewTextInput"
                                     TextChanged="TxtHeightOffset_TextChanged"/>
                            <TextBlock x:Name="lblHeightOffsetUnit"
                                       Style="{StaticResource Weave.BodyText}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="lblHeightOffsetError"
                                   Style="{StaticResource Weave.ErrorText}"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock x:Name="lblDirectionAngle"
                               Grid.Row="2"
                               Grid.Column="0"
                               Style="{StaticResource Weave.BodyText}"
                               VerticalAlignment="Top"
                               Margin="0,6,16,0"/>
                    <StackPanel Grid.Row="2"
                                Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="cboDirectionAngle"
                                      Width="120"
                                      Style="{StaticResource Weave.ComboBox.Editable}"
                                      LostKeyboardFocus="CboDirectionAngle_LostKeyboardFocus"/>
                            <TextBlock x:Name="lblDegree"
                                       Style="{StaticResource Weave.BodyText}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="lblDirectionAngleError"
                                   Style="{StaticResource Weave.ErrorText}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnOK"
                            Style="{StaticResource Weave.Button.Primary}"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="BtnOK_Click"/>
                    <Button x:Name="btnCancel"
                            Style="{StaticResource Weave.Button.Secondary}"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
