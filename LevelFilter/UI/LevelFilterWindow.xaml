<Window x:Class="ADSK.JExtRAC.LevelFilter.UI.LevelFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level Filter"
        Width="620" Height="560"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6" CaptionHeight="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="secBd" CornerRadius="4" BorderThickness="1" Padding="12,4"
                    Background="Transparent" BorderBrush="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="secBd" Property="Opacity" Value="0.8" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border x:Name="outerBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="titleBarGrid" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="titleText" Text="Level Filter"
                           FontSize="14" FontWeight="SemiBold"
                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
                <Button x:Name="btnClose" Click="BtnClose_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Width="28" Height="28"
                        Background="Transparent" BorderBrush="Transparent" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Divider -->
            <Border x:Name="dividerBorder" Grid.Row="1" />

            <!-- Tab Content -->
            <TabControl x:Name="tabControl" Grid.Row="2" Margin="12,12,12,0"
                        SelectionChanged="TabControl_SelectionChanged">
                <TabItem x:Name="tabCategory" Header="Category">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgCategory" Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single" IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="CheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblSelItemsCat" Text="Selected Items" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblSelItemsCountCat" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblTotalSelCat" Text="Total Selected" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblTotalSelCountCat" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="btnSelectAllCat" Grid.Column="3" Content="Select All"
                                    Click="BtnSelectAll_Click" Margin="0,0,8,0"
                                    Width="90" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                            <Button x:Name="btnClearCat" Grid.Column="4" Content="Clear Selection"
                                    Click="BtnClear_Click"
                                    Width="100" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabFamily" Header="Family">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgFamily" Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single" IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="CheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Family" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblSelItemsFam" Text="Selected Items" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblSelItemsCountFam" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblTotalSelFam" Text="Total Selected" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblTotalSelCountFam" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="btnSelectAllFam" Grid.Column="3" Content="Select All"
                                    Click="BtnSelectAll_Click" Margin="0,0,8,0"
                                    Width="90" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                            <Button x:Name="btnClearFam" Grid.Column="4" Content="Clear Selection"
                                    Click="BtnClear_Click"
                                    Width="100" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabFamilyType" Header="Family Type">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgFamilyType" Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single" IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="CheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Category" Binding="{Binding SubName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Family Type" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblSelItemsFT" Text="Selected Items" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblSelItemsCountFT" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblTotalSelFT" Text="Total Selected" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblTotalSelCountFT" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="btnSelectAllFT" Grid.Column="3" Content="Select All"
                                    Click="BtnSelectAll_Click" Margin="0,0,8,0"
                                    Width="90" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                            <Button x:Name="btnClearFT" Grid.Column="4" Content="Clear Selection"
                                    Click="BtnClear_Click"
                                    Width="100" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabParts" Header="Parts">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgParts" Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single" IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="CheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Material" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblSelItemsParts" Text="Selected Items" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblSelItemsCountParts" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblTotalSelParts" Text="Total Selected" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblTotalSelCountParts" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="btnSelectAllParts" Grid.Column="3" Content="Select All"
                                    Click="BtnSelectAll_Click" Margin="0,0,8,0"
                                    Width="90" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                            <Button x:Name="btnClearParts" Grid.Column="4" Content="Clear Selection"
                                    Click="BtnClear_Click"
                                    Width="100" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabFilters" Header="Filters">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="dgFilters" Grid.Row="0"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single" IsReadOnly="False"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="1" Margin="0,8,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Click="CheckBox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Filter" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock x:Name="lblSelItemsFilters" Text="Selected Items" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblSelItemsCountFilters" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock x:Name="lblTotalSelFilters" Text="Total Selected" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="lblTotalSelCountFilters" Text="0" FontSize="11" FontWeight="Bold"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="btnSelectAllFilters" Grid.Column="3" Content="Select All"
                                    Click="BtnSelectAll_Click" Margin="0,0,8,0"
                                    Width="90" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                            <Button x:Name="btnClearFilters" Grid.Column="4" Content="Clear Selection"
                                    Click="BtnClear_Click"
                                    Width="100" Height="28" FontSize="11" Cursor="Hand"
                                    FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                    Template="{StaticResource SecondaryButtonTemplate}" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Border x:Name="footerBorder" Grid.Row="3" Padding="20,12,20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnOk" Content="OK" Click="BtnOk_Click"
                            Width="90" Height="32" FontSize="13" FontWeight="SemiBold"
                            FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="okBd" CornerRadius="4" Padding="16,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="okBd" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnCancel" Content="Cancel" Click="BtnCancel_Click"
                            Width="90" Height="32" FontSize="13" FontWeight="SemiBold"
                            FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cancelBd" CornerRadius="4" BorderThickness="1" Padding="16,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cancelBd" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnApply" Content="Apply" Click="BtnApply_Click"
                            Width="90" Height="32" FontSize="13" FontWeight="SemiBold"
                            FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="applyBd" CornerRadius="4" BorderThickness="1" Padding="16,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="applyBd" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
