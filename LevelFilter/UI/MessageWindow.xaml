<Window x:Class="ADSK.JExtRAC.LevelFilter.UI.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        Width="420" Height="Auto"
        SizeToContent="Height"
        MaxHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True">
    <Border x:Name="outerBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="titleBarGrid" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="titleText" Text="Warning"
                           FontSize="14" FontWeight="SemiBold"
                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
                <Button x:Name="btnClose" Click="BtnClose_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Width="28" Height="28"
                        Background="Transparent" BorderBrush="Transparent" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2" Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <Border x:Name="dividerBorder" Grid.Row="1" />
            <StackPanel Grid.Row="2" Margin="20,16,20,16">
                <TextBlock x:Name="messageText" FontSize="13"
                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                           TextWrapping="Wrap" LineHeight="20" />
            </StackPanel>
            <Border x:Name="footerBorder" Grid.Row="3" Padding="20,12,20,16">
                <Button x:Name="btnOk" Content="OK" Click="BtnOk_Click"
                        HorizontalAlignment="Right" Width="80" Height="32"
                        FontSize="13" FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                        FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="okBd" CornerRadius="4" Padding="16,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="okBd" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
