<Window x:Class="ADSK.JExtRAC.SwitchJoinOrder.UI.FormSwitchJoinWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch Join Order"
        Width="640"
        MinWidth="560"
        Height="560"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.SwitchJoinOrder;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{DynamicResource Weave.Brush.Chrome.CloseHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <Grid Grid.Row="2" Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lbLeft"
                           Grid.Row="0"
                           Grid.Column="0"
                           Style="{StaticResource Weave.SectionTitle}"/>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="lbRight" Style="{StaticResource Weave.SectionTitle}" Margin="0,0,8,8"/>
                    <TextBlock x:Name="lbCount" Style="{StaticResource Weave.HintText}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                </StackPanel>

                <ListView x:Name="listAvailable"
                          Grid.Row="1"
                          Grid.Column="0"
                          Style="{StaticResource Weave.ListView}"
                          ItemContainerStyle="{StaticResource Weave.ListViewItem}"
                          MouseDoubleClick="ListAvailable_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource Weave.ListViewTextBlock}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <Button x:Name="btnAdd"
                            Style="{StaticResource Weave.Button.Secondary}"
                            MinWidth="48"
                            Margin="0,0,0,8"
                            Click="BtnAdd_Click"/>
                    <Button x:Name="btnRm"
                            Style="{StaticResource Weave.Button.Secondary}"
                            MinWidth="48"
                            Margin="0,0,0,24"
                            Click="BtnRemove_Click"/>
                    <TextBlock x:Name="lbPriorityHint"
                               Style="{StaticResource Weave.HintText}"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                    <Button x:Name="btnUp"
                            Style="{StaticResource Weave.Button.Secondary}"
                            MinWidth="48"
                            Margin="0,0,0,8"
                            Click="BtnUp_Click"/>
                    <Button x:Name="btnDown"
                            Style="{StaticResource Weave.Button.Secondary}"
                            MinWidth="48"
                            Click="BtnDown_Click"/>
                </StackPanel>

                <ListView x:Name="listPriority"
                          Grid.Row="1"
                          Grid.Column="2"
                          Style="{StaticResource Weave.ListView}"
                          ItemContainerStyle="{StaticResource Weave.ListViewItem}"
                          SelectionChanged="ListPriority_SelectionChanged"
                          MouseDoubleClick="ListPriority_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           Style="{StaticResource Weave.ListViewTextBlock}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Count}"
                                           Style="{StaticResource Weave.ListViewTextBlock.Secondary}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Row="3" Margin="24,16,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnDetails"
                        Grid.Column="0"
                        Style="{StaticResource Weave.Button.Secondary}"
                        HorizontalAlignment="Left"
                        Click="BtnDetails_Click"/>

                <CheckBox x:Name="ckbGroup"
                          Grid.Column="1"
                          Style="{StaticResource Weave.CheckBox}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnCancel"
                            Style="{StaticResource Weave.Button.Secondary}"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="btnOK"
                            Style="{StaticResource Weave.Button.Primary}"
                            IsDefault="True"
                            Click="BtnOK_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
