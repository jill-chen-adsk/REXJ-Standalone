<Window x:Class="ADSK.ViewExtension.ViewDuplicate.UI.FormViewDuplicateWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.ViewExtension.ViewDuplicate;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           Style="{StaticResource Weave.TitleText}"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{DynamicResource Weave.Brush.Chrome.CloseHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <Grid Grid.Row="2" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="520"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock x:Name="lblDiscipline" Style="{StaticResource Weave.FieldLabel}"/>
                    <ComboBox x:Name="cbxDiscipline"
                              Style="{StaticResource Weave.ComboBox}"
                              Margin="0,0,0,12"
                              SelectionChanged="CbxDiscipline_SelectionChanged"/>

                    <TextBlock x:Name="lblViewCategory" Style="{StaticResource Weave.FieldLabel}"/>
                    <ComboBox x:Name="cbxViewType"
                              Style="{StaticResource Weave.ComboBox}"
                              Margin="0,0,0,12"
                              SelectionChanged="CbxViewType_SelectionChanged"/>

                    <TextBlock x:Name="lblViewTypeFilter" Style="{StaticResource Weave.FieldLabel}"/>
                    <ComboBox x:Name="cbxViewFamilyType"
                              Style="{StaticResource Weave.ComboBox}"
                              Margin="0,0,0,12"
                              SelectionChanged="CbxViewFamilyType_SelectionChanged"/>

                    <TextBlock x:Name="lblViews" Style="{StaticResource Weave.FieldLabel}"/>
                    <ListBox x:Name="lbxViews"
                             Style="{StaticResource Weave.ListBox}"
                             Height="220"
                             Margin="0,0,0,12"/>

                    <TextBlock x:Name="lblDupMode" Style="{StaticResource Weave.FieldLabel}"/>
                    <ComboBox x:Name="cbxDupMode" Style="{StaticResource Weave.ComboBox}"/>
                </StackPanel>

                <Grid Grid.Row="0" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblRules" Grid.Row="0" Style="{StaticResource Weave.FieldLabel}"/>

                    <DataGrid x:Name="dgRules"
                              Grid.Row="1"
                              Style="{StaticResource Weave.DataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="colPosition"
                                                Binding="{Binding PositionText, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="96"/>
                            <DataGridTextColumn x:Name="colAddedText"
                                                Binding="{Binding AddedText, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource Weave.DataGrid.EditingTextBox}"
                                                Width="*"/>
                            <DataGridTextColumn x:Name="colViewTemplate"
                                                Binding="{Binding ViewTemplateText, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="*"/>
                            <DataGridTextColumn x:Name="colViewType"
                                                Binding="{Binding ViewFamilyTypeText, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="btnAdd"
                                Style="{StaticResource Weave.Button.Tertiary}"
                                Margin="0,0,8,0"
                                Click="BtnAdd_Click"/>
                        <Button x:Name="btnDelete"
                                Style="{StaticResource Weave.Button.Tertiary}"
                                Click="BtnDelete_Click"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0">
                    <Button x:Name="btnOK"
                            Style="{StaticResource Weave.Button.Primary}"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="BtnOK_Click"/>
                    <Button x:Name="btnCancel"
                            Style="{StaticResource Weave.Button.Secondary}"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
