<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark-theme overrides for WeaveDialogResources.xaml; merged by WeaveTheme only when Revit uses the dark theme. -->
    <Color x:Key="Weave.Color.Text.Primary">#E0E8F0</Color>
    <Color x:Key="Weave.Color.Text.Secondary">#C0CCD8</Color>
    <Color x:Key="Weave.Color.Border">#3A4F63</Color>
    <Color x:Key="Weave.Color.Surface">#263545</Color>
    <Color x:Key="Weave.Color.Surface.Subtle">#2E3F50</Color>
    <Color x:Key="Weave.Color.Input">#34495F</Color>
    <Color x:Key="Weave.Color.GridLine">#4A6278</Color>
    <Color x:Key="Weave.Color.Header.Background">#3A4F63</Color>
    <Color x:Key="Weave.Color.Header.Rule">#C0CCD8</Color>
    <Color x:Key="Weave.Color.Chrome.CloseHover">#33FFFFFF</Color>
    <Color x:Key="Weave.Color.State.Hover">#33000000</Color>

    <SolidColorBrush x:Key="Weave.Brush.Text.Primary" Color="{StaticResource Weave.Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Weave.Brush.Text.Secondary" Color="{StaticResource Weave.Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Weave.Brush.Border" Color="{StaticResource Weave.Color.Border}"/>
    <SolidColorBrush x:Key="Weave.Brush.Surface" Color="{StaticResource Weave.Color.Surface}"/>
    <SolidColorBrush x:Key="Weave.Brush.Surface.Subtle" Color="{StaticResource Weave.Color.Surface.Subtle}"/>
    <SolidColorBrush x:Key="Weave.Brush.Input" Color="{StaticResource Weave.Color.Input}"/>
    <SolidColorBrush x:Key="Weave.Brush.GridLine" Color="{StaticResource Weave.Color.GridLine}"/>
    <SolidColorBrush x:Key="Weave.Brush.Header.Background" Color="{StaticResource Weave.Color.Header.Background}"/>
    <SolidColorBrush x:Key="Weave.Brush.Header.Rule" Color="{StaticResource Weave.Color.Header.Rule}"/>
    <SolidColorBrush x:Key="Weave.Brush.Chrome.CloseHover" Color="{StaticResource Weave.Color.Chrome.CloseHover}"/>
    <SolidColorBrush x:Key="Weave.Brush.State.Hover" Color="{StaticResource Weave.Color.State.Hover}"/>
</ResourceDictionary>
