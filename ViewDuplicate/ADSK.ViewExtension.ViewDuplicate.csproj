<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug 2027</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <OutputType>Library</OutputType>
    <RootNamespace>ADSK.ViewExtension.ViewDuplicate</RootNamespace>
    <AssemblyName>ADSK.ViewExtension.ViewDuplicate</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <PlatformTarget>x64</PlatformTarget>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <NeutralLanguage>ja</NeutralLanguage>
    <Configurations>Debug 2027;Release 2027</Configurations>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug 2027|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugType>embedded</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release 2027|x64'">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UI\DlgViewDuplicate.Designer.cs">
      <DependentUpon>DlgViewDuplicate.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\DlgViewDuplicateItem.Designer.cs">
      <DependentUpon>DlgViewDuplicateItem.cs</DependentUpon>
    </Compile>
    <Compile Update="Resources\Text.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Text.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="UI\DlgViewDuplicate.resx">
      <DependentUpon>DlgViewDuplicate.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\DlgViewDuplicateItem.resx">
      <DependentUpon>DlgViewDuplicateItem.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Text.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Text.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Text.en.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Include="1_ADSK.ViewExtension.ViewDuplicate.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
