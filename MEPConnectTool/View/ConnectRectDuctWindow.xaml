<Window x:Class="MEPConnectTool.View.ConnectRectDuctWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MEPConnectTool.View"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Title="Rectangular Duct Fitting" Height="auto" Width="auto">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UIStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <StackPanel Orientation="Vertical">
            
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <GroupBox Header="Reference"  Style="{StaticResource GroupBox}">
                    <StackPanel Orientation="Vertical" >
                        <Image Source="../Res/RectDuct_0_480dpi.png" Width="125" Visibility="{Binding ElementName=RadioButtonLengthAuto, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Image Source="../Res/RectDuct_1_480dpi.png" Width="125" Visibility="{Binding ElementName=RadioButtonLengthFixed, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="Options" Style="{StaticResource GroupBox}" Width="180">
                    <StackPanel Orientation="Vertical" >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Label Content="Joint Length" />
                            <RadioButton x:Name="RadioButtonLengthAuto" GroupName="Length" Content="Auto" IsChecked="True" Style="{StaticResource RadioButton}" />
                            <RadioButton x:Name="RadioButtonLengthFixed" GroupName="Length" Content="Fixed"  Style="{StaticResource RadioButton}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Visibility="{Binding ElementName=RadioButtonLengthFixed, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox x:Name="LengthTextBox" Width="48" Text="600"  />
                            <TextBlock Text="mm" VerticalAlignment="Center" Margin="5 0 5 0"/>
                        </StackPanel>

                        <CheckBox x:Name="HopperPreferredCheckbox" Content="Prefer Hopper" Style="{StaticResource CheckBox}"/>
                    </StackPanel>
                </GroupBox>
                


            </StackPanel>
            
            

            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 0 8" >
                <Button Content="Cancel" Click="Cancel_OnClick" Style="{StaticResource Button}"/>
                <Button Content="Place"  Click="Place_OnClick" Style="{StaticResource Button}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>