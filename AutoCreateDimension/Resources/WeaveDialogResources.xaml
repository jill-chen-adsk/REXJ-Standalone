<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Weave.Color.Text.Primary">#3C3C3C</Color>
    <Color x:Key="Weave.Color.Text.Secondary">#6B6B6B</Color>
    <Color x:Key="Weave.Color.Border">#D9D9D9</Color>
    <Color x:Key="Weave.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Weave.Color.Surface.Subtle">#F5F5F5</Color>
    <Color x:Key="Weave.Color.Input">#FFFFFF</Color>
    <Color x:Key="Weave.Color.Accent">#0696D7</Color>
    <Color x:Key="Weave.Color.Accent.Hover">#0586C1</Color>
    <Color x:Key="Weave.Color.Error">#E34850</Color>
    <Color x:Key="Weave.Color.Shadow">#000000</Color>
    <Color x:Key="Weave.Color.Diagram.Accent">#D92B36</Color>
    <Color x:Key="Weave.Color.Accent.Foreground">#FFFFFF</Color>
    <Color x:Key="Weave.Color.Chrome.CloseHover">#20000000</Color>

    <SolidColorBrush x:Key="Weave.Brush.Chrome.CloseHover" Color="{DynamicResource Weave.Color.Chrome.CloseHover}"/>
    <SolidColorBrush x:Key="Weave.Brush.Accent.Foreground" Color="{DynamicResource Weave.Color.Accent.Foreground}"/>

    <SolidColorBrush x:Key="Weave.Brush.Text.Primary" Color="{DynamicResource Weave.Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Weave.Brush.Text.Secondary" Color="{DynamicResource Weave.Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Weave.Brush.Border" Color="{DynamicResource Weave.Color.Border}"/>
    <SolidColorBrush x:Key="Weave.Brush.Surface" Color="{DynamicResource Weave.Color.Surface}"/>
    <SolidColorBrush x:Key="Weave.Brush.Surface.Subtle" Color="{DynamicResource Weave.Color.Surface.Subtle}"/>
    <SolidColorBrush x:Key="Weave.Brush.Input" Color="{DynamicResource Weave.Color.Input}"/>
    <SolidColorBrush x:Key="Weave.Brush.Accent" Color="{StaticResource Weave.Color.Accent}"/>
    <SolidColorBrush x:Key="Weave.Brush.Accent.Hover" Color="{StaticResource Weave.Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Weave.Brush.Error" Color="{StaticResource Weave.Color.Error}"/>
    <SolidColorBrush x:Key="Weave.Brush.Diagram.Accent" Color="{DynamicResource Weave.Color.Diagram.Accent}"/>

    <Style x:Key="Weave.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Weave.ChromeWindow" TargetType="Window" BasedOn="{StaticResource Weave.Window}">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="Weave.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Weave.BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>


    <Style x:Key="Weave.GroupPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface.Subtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>



    <Style x:Key="Weave.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Weave.RadioButton" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Weave.RichTextBox" TargetType="RichTextBox">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>





    <Style x:Key="Weave.Button.Primary" TargetType="Button">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Accent.Foreground}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Weave.Brush.Accent.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Weave.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Weave.Button.Primary}">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface.Subtle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
