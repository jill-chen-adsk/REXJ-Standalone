<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Quantity</RootNamespace>
    <AssemblyName>Quantity</AssemblyName>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>REVIT2027</DefineConstants>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UIFramework">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\UIFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ExtApp.cs" />
    <Compile Include="CmdShowManual.cs" />
    <Compile Include="CmdQuantityDuctExport.cs" />
    <Compile Include="CmdQuantityPipeExport.cs" />
    <Compile Include="CmdQuantityReason.cs" />
    <Compile Include="Components\Attribute.cs" />
    <Compile Include="Components\UI.cs" />
    <Compile Include="Components\Elements.cs" />
    <Compile Include="Components\Geometry.cs" />
    <Compile Include="Components\Parameters.cs" />
    <Compile Include="Components\Service.cs" />
    <Compile Include="Components\Settings.cs" />
    <Compile Include="Entities\DtBase.cs" />
    <Compile Include="Entities\DtCmd.cs" />
    <Compile Include="Entities\SpBase.cs" />
    <Compile Include="Entities\SpCmd.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Text.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Image.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Quantity.addin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\**\**" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data')" />
  </ItemGroup>
</Project>
