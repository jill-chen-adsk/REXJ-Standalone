<Window x:Class="ADSK.JExtRAC.CheckingALVS.UI.FormEnvironmentalCheckWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environmental check"
        Height="760"
        Width="1400"
        MinWidth="1200"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.CheckingALVS;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <Grid Grid.Row="2" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left: room group -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,0">
                    <TextBlock x:Name="lblSelectRoomGroup" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="lblRoomGroup" Style="{StaticResource Weave.SectionTitle}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource Weave.GroupPanel}" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TreeView x:Name="trvRoomGroup"
                                      Style="{StaticResource Weave.TreeView}"
                                      MinHeight="160"
                                      MaxHeight="200"
                                      SelectedItemChanged="TrvRoomGroup_SelectedItemChanged"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnAddGroup"
                                        Grid.Column="0"
                                        Style="{StaticResource Weave.Button.Tertiary.Compact}"
                                        Click="BtnAddGroup_Click"/>
                                <Button x:Name="btnDelGroup"
                                        Grid.Column="2"
                                        Style="{StaticResource Weave.Button.Tertiary.Compact}"
                                        Click="BtnDelGroup_Click"/>
                                <Button x:Name="btnEditRoomGroup"
                                        Grid.Column="4"
                                        Style="{StaticResource Weave.Button.Tertiary.Compact}"
                                        Click="BtnEditRoomGroup_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="lblTotalRoomGroup" Style="{StaticResource Weave.SectionTitle}" Margin="0,8,0,8"/>
                    <Border Style="{StaticResource Weave.GroupPanel}">
                        <StackPanel>
                            <TextBlock x:Name="lblGroupNecessaryArea" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtGroupNecessaryArea" Style="{StaticResource Weave.TextBox}" IsReadOnly="True" Margin="0,0,0,8"/>
                            <TextBlock x:Name="lblGroupUsableArea" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtGroupUsableArea" Style="{StaticResource Weave.TextBox}" IsReadOnly="True" Margin="0,0,0,8"/>
                            <TextBlock x:Name="lblGroupJudgment" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtGroupJudgment" Style="{StaticResource Weave.TextBox}" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: grids -->
                <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblSelectRoom" Grid.Row="0" Style="{StaticResource Weave.SectionTitle}"/>
                    <DataGrid x:Name="dgvSelectRoom"
                              Grid.Row="1"
                              Style="{StaticResource Weave.DataGrid}"
                              IsReadOnly="False"
                              Margin="0,0,0,12"
                              SelectionChanged="DgvSelectRoom_SelectionChanged"
                              CellEditEnding="DgvSelectRoom_CellEditEnding"/>

                    <TextBlock x:Name="lblSelectParts" Grid.Row="2" Style="{StaticResource Weave.SectionTitle}"/>
                    <DataGrid x:Name="dgvSelectParts"
                              Grid.Row="3"
                              Style="{StaticResource Weave.DataGrid}"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              CellEditEnding="DgvSelectParts_CellEditEnding"/>
                </Grid>

                <!-- Right: bulk panels -->
                <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="gpbLighting" Style="{StaticResource Weave.GroupPanel}">
                            <StackPanel>
                                <TextBlock x:Name="gpbLightingTitle" Style="{StaticResource Weave.SectionTitle}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbVerandaTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="chkVeranda" Style="{StaticResource Weave.CheckBox}" Margin="0,0,8,0"/>
                                            <Button x:Name="btnVeranda" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnVeranda_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbRoadSideTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="chkRoadSide" Style="{StaticResource Weave.CheckBox}" Margin="0,0,8,0"/>
                                            <Button x:Name="btnRoadSide" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnRoadSide_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbHorizontalMeasTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtHorizontalMeas" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnHorizontalMeas" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnHorizontalMeas_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbHorizontalCorrTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtHorizontalCorr" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnHorizontalCorr" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnHorizontalCorr_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbVerticalMeasTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtVerticalMeas" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnVerticalMeas" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnVerticalMeas_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbVerticalCorrTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtVerticalCorr" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnVerticalCorr" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnVerticalCorr_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="gpbSmoke" Style="{StaticResource Weave.GroupPanel}">
                            <StackPanel>
                                <TextBlock x:Name="gpbSmokeTitle" Style="{StaticResource Weave.SectionTitle}" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbHeadHeightTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtHeadHeight" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnHeadHeight" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnHeadHeight_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbCeilingHeightTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtCeilingHeight" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnCeilingHeight" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnCeilingHeight_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbSmokeWallLengthTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtSmokeWallLength" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnSmokeWallLength" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnSmokeWallLength_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Weave.RoundingPanel}">
                                    <StackPanel>
                                        <TextBlock x:Name="gpbUsableHeightSmokeTitle" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="txtUsableHeightSmoke" Style="{StaticResource Weave.TextBox}" Width="72" Margin="0,0,8,0" LostFocus="BulkNumericTextBox_LostFocus"/>
                                            <Button x:Name="btnUsableHeightSmoke" Style="{StaticResource Weave.Button.Tertiary}" Click="BtnUsableHeightSmoke_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="lblUseDistrict" Style="{StaticResource Weave.BodyText}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cboUseDistrict"
                                  Style="{StaticResource Weave.ComboBox}"
                                  Width="140"
                                  Margin="0,0,16,0"
                                  SelectionChanged="CboUseDistrict_SelectionChanged"/>
                        <CheckBox x:Name="chkCreateHeader" Style="{StaticResource Weave.CheckBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnSelectParts" Style="{StaticResource Weave.Button.Secondary}" Margin="0,0,8,0"/>
                        <Button x:Name="btnOutExcel" Style="{StaticResource Weave.Button.Primary}" Margin="0,0,8,0"/>
                        <Button x:Name="btnClose" Style="{StaticResource Weave.Button.Secondary}" Margin="0,0,8,0"/>
                        <Button x:Name="btnCancel" Style="{StaticResource Weave.Button.Secondary}" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
