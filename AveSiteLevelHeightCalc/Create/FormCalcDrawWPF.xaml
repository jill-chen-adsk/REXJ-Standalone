<Window x:Class="ADSK.JExtRAC.AveSiteLevelHeightCalc.Create.FormCalcDrawWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create avg. ground level calc. drawing"
        Height="680"
        Width="520"
        MinWidth="480"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.AveSiteLevelHeightCalc;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="24,16,24,0">
                <StackPanel>
                    <Border Style="{StaticResource Weave.SectionPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="lblCalcPoint" Style="{StaticResource Weave.SectionTitle}"/>
                                <DataGrid x:Name="dgvCalcPoint"
                                          Style="{StaticResource Weave.DataGrid}"
                                          MinHeight="220"
                                          MaxHeight="280"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          SelectionUnit="Cell"
                                          ColumnHeaderStyle="{StaticResource Weave.DataGridColumnHeader}"
                                          CellStyle="{StaticResource Weave.DataGridCell}"
                                          CellEditEnding="DgvCalcPoint_CellEditEnding"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Width="96">
                                <Button x:Name="btnUp" Style="{StaticResource Weave.Button.Tertiary.Compact}" Margin="0,0,0,8" Click="BtnUp_Click"/>
                                <Button x:Name="btnDn" Style="{StaticResource Weave.Button.Tertiary.Compact}" Margin="0,0,0,8" Click="BtnDn_Click"/>
                                <Button x:Name="btnDel" Style="{StaticResource Weave.Button.Tertiary.Compact}" Margin="0,0,0,8" Click="BtnDel_Click"/>
                                <Button x:Name="btnUpdateNumber" Style="{StaticResource Weave.Button.Tertiary.Compact}" Click="BtnUpdateNumber_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblBMHeight" Grid.Column="0" Style="{StaticResource Weave.BodyText}" Margin="0,0,12,0"/>
                        <TextBox x:Name="txtBMHeight" Grid.Column="1" Style="{StaticResource Weave.TextBox}" TextAlignment="Right" LostFocus="TxtBMHeight_LostFocus"/>
                        <Button x:Name="btnUpdateLevel" Grid.Column="2" Style="{StaticResource Weave.Button.Tertiary}" Margin="12,0,0,0" Click="BtnUpdateLevel_Click"/>
                    </Grid>

                    <Border Style="{StaticResource Weave.SectionPanel}">
                        <StackPanel>
                            <TextBlock x:Name="lblCalcDraw" Style="{StaticResource Weave.SectionTitle}"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblScale" Grid.Column="0" Style="{StaticResource Weave.BodyText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lbl1Slash" Grid.Column="1" Style="{StaticResource Weave.BodyText}" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtScale" Grid.Column="2" Style="{StaticResource Weave.TextBox}" TextAlignment="Right" LostFocus="TxtScale_LostFocus"/>
                            </Grid>

                            <TextBlock x:Name="lblRate" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblHorizontal" Grid.Column="0" Style="{StaticResource Weave.BodyText}" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtHorizontal" Grid.Column="1" Style="{StaticResource Weave.TextBox}" TextAlignment="Right" LostFocus="TxtHorizontal_LostFocus"/>
                                <TextBlock x:Name="lblVertical" Grid.Column="2" Style="{StaticResource Weave.BodyText}" Margin="16,0,8,0"/>
                                <TextBox x:Name="txtVertical" Grid.Column="3" Style="{StaticResource Weave.TextBox}" TextAlignment="Right" LostFocus="TxtVertical_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Weave.SectionPanel}" Margin="0">
                        <StackPanel>
                            <TextBlock x:Name="lblAreaDecimalSection" Style="{StaticResource Weave.SectionTitle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="lblLengthUnit" Style="{StaticResource Weave.BodyText}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton x:Name="rdbLengthMM" Style="{StaticResource Weave.RadioButton}" GroupName="LengthUnit"/>
                                        <RadioButton x:Name="rdbLengthM" Style="{StaticResource Weave.RadioButton}" GroupName="LengthUnit"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="lblAreaDecimal" Style="{StaticResource Weave.BodyText}" Margin="0,0,8,0"/>
                                        <TextBox x:Name="txtAreaDecimal" Style="{StaticResource Weave.TextBox}" Width="56" MaxLength="1" TextAlignment="Right" LostFocus="TxtAreaDecimal_LostFocus"/>
                                        <TextBlock x:Name="lblAreaOrder" Style="{StaticResource Weave.BodyText}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Weave.RoundingPanel}">
                                    <StackPanel>
                                        <RadioButton x:Name="rdbAreaCut" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaRounding"/>
                                        <RadioButton x:Name="rdbAreaClose" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaRounding"/>
                                        <RadioButton x:Name="rdbAreaRounding" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaRounding" Margin="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" BorderBrush="{DynamicResource Weave.Brush.Border}" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCreate" Style="{StaticResource Weave.Button.Primary}" Margin="0,0,8,0" Click="BtnCreate_Click"/>
                    <Button x:Name="btnClose" Style="{StaticResource Weave.Button.Secondary}" Margin="0,0,8,0" Click="BtnClose_Click"/>
                    <Button x:Name="btnCancel" Style="{StaticResource Weave.Button.Secondary}" IsCancel="True" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
