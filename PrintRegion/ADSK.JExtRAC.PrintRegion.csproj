<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug 2027</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ADSK.JExtRAC.PrintRegion</RootNamespace>
    <AssemblyName>ADSK.JExtRAC.PrintRegion</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug 2027;Release 2027</Configurations>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <NeutralLanguage>ja</NeutralLanguage>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug 2027|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugType>embedded</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release 2027|x64'">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Text.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Text.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Image.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Image.resx</DependentUpon>
    </Compile>
    <Compile Update="UI\PrintFrm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\PrintFrm.Designer.cs">
      <DependentUpon>PrintFrm.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\PrintSetupForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\PrintSetupForm.designer.cs">
      <DependentUpon>PrintSetupForm.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\SaveAsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\SaveAsForm.designer.cs">
      <DependentUpon>SaveAsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="UI\ReNameForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="UI\ReNameForm.designer.cs">
      <DependentUpon>ReNameForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Image.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Image.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Text.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Text.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Text.en.resx" />
    <EmbeddedResource Update="UI\PrintFrm.resx">
      <DependentUpon>PrintFrm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\PrintSetupForm.resx">
      <DependentUpon>PrintSetupForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\SaveAsForm.resx">
      <DependentUpon>SaveAsForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\ReNameForm.resx">
      <DependentUpon>ReNameForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="ADSK.JExtRAC.PrintRegion.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
