<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug 2027</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>ADSK.JExtRAC.EnhancedSectionBox</RootNamespace>
    <AssemblyName>ADSK.JExtRAC.EnhancedSectionBox</AssemblyName>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
    <Configurations>Debug 2027;Release 2027</Configurations>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug 2027|x64'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <DebugType>embedded</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release 2027|x64'">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <ErrorReport>prompt</ErrorReport>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Commands\CmdBoxView.cs" />
    <Compile Update="Commands\CmdSectionBoxAdjustment.cs" />
    <Compile Update="Common\ComDialog.cs" />
    <Compile Update="Screen\FormBoxView.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Screen\FormBoxView.Designer.cs">
      <DependentUpon>FormBoxView.cs</DependentUpon>
    </Compile>
    <Compile Update="Screen\FormSectionBoxAdjustment.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Screen\FormSectionBoxAdjustment.Designer.cs">
      <DependentUpon>FormSectionBoxAdjustment.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Screen\FormBoxView.resx">
      <DependentUpon>FormBoxView.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Screen\FormSectionBoxAdjustment.resx">
      <DependentUpon>FormSectionBoxAdjustment.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Text.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Text.en.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ADSK.JExtRAC.EnhancedSectionBox.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
