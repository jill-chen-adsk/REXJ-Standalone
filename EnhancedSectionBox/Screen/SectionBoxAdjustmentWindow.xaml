<Window x:Class="ADSK.JExtRAC.EnhancedSectionBox.Screen.SectionBoxAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Section Box Adjustment"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True">
    <Border x:Name="outerBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid x:Name="titleBarGrid" Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="titleText" Text="Section Box Adjustment"
                           FontSize="14" FontWeight="SemiBold"
                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                           VerticalAlignment="Center" Margin="20,0,0,0" />
                <Button x:Name="btnClose" Click="BtnClose_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Width="28" Height="28"
                        Background="Transparent" BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Divider -->
            <Border x:Name="dividerBorder" Grid.Row="1" />

            <!-- Content -->
            <StackPanel Grid.Row="2" Margin="20,16,20,8">
                <!-- Group: Length Adjustment -->
                <Border x:Name="groupBorder" BorderThickness="1" CornerRadius="4" Padding="16,12,16,16">
                    <StackPanel>
                        <TextBlock x:Name="groupTitle" Text="Length Adjustment"
                                   FontSize="12" FontWeight="SemiBold"
                                   FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                   Margin="0,0,0,12" />

                        <!-- Row 1: Left, Front, Top -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left -->
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="lblLeft" Text="Left" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="textOffsetLeft" Text="0" TextAlignment="Right"
                                             FontSize="12" Height="28" VerticalContentAlignment="Center"
                                             MaxLength="7" Padding="4,0" />
                                    <TextBlock Text="mm" Grid.Column="1" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontFamily="ArtifaktElement, Segoe UI, sans-serif" />
                                </Grid>
                            </StackPanel>

                            <!-- Front -->
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="lblFront" Text="Front" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="textOffsetForward" Text="0" TextAlignment="Right"
                                             FontSize="12" Height="28" VerticalContentAlignment="Center"
                                             MaxLength="7" Padding="4,0" />
                                    <TextBlock Text="mm" Grid.Column="1" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontFamily="ArtifaktElement, Segoe UI, sans-serif" />
                                </Grid>
                            </StackPanel>

                            <!-- Top -->
                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="lblTop" Text="Top" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="textOffsetTop" Text="0" TextAlignment="Right"
                                             FontSize="12" Height="28" VerticalContentAlignment="Center"
                                             MaxLength="7" Padding="4,0" />
                                    <TextBlock Text="mm" Grid.Column="1" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontFamily="ArtifaktElement, Segoe UI, sans-serif" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Right, Back, Bottom -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Right -->
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="lblRight" Text="Right" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="textOffsetRight" Text="0" TextAlignment="Right"
                                             FontSize="12" Height="28" VerticalContentAlignment="Center"
                                             MaxLength="7" Padding="4,0" />
                                    <TextBlock Text="mm" Grid.Column="1" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontFamily="ArtifaktElement, Segoe UI, sans-serif" />
                                </Grid>
                            </StackPanel>

                            <!-- Back -->
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="lblBack" Text="Back" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="textOffsetBack" Text="0" TextAlignment="Right"
                                             FontSize="12" Height="28" VerticalContentAlignment="Center"
                                             MaxLength="7" Padding="4,0" />
                                    <TextBlock Text="mm" Grid.Column="1" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontFamily="ArtifaktElement, Segoe UI, sans-serif" />
                                </Grid>
                            </StackPanel>

                            <!-- Bottom -->
                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="lblBottom" Text="Bottom" FontSize="11"
                                           FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="textOffsetBottom" Text="0" TextAlignment="Right"
                                             FontSize="12" Height="28" VerticalContentAlignment="Center"
                                             MaxLength="7" Padding="4,0" />
                                    <TextBlock Text="mm" Grid.Column="1" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               FontFamily="ArtifaktElement, Segoe UI, sans-serif" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer with OK / Cancel -->
            <Border x:Name="footerBorder" Grid.Row="3" Padding="20,12,20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnOk" Content="OK" Click="BtnOk_Click"
                            Width="90" Height="32"
                            FontSize="13" FontWeight="SemiBold"
                            FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                            Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="okBd" CornerRadius="4" Padding="16,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="okBd" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="btnCancel" Content="Cancel" Click="BtnCancel_Click"
                            Width="90" Height="32"
                            FontSize="13" FontWeight="SemiBold"
                            FontFamily="ArtifaktElement, Segoe UI, sans-serif"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cancelBd" CornerRadius="4" BorderThickness="1" Padding="16,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cancelBd" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
