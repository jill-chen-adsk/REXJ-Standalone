<Window x:Class="ADSK.JExtRAC.AreaSchedule.GroundsExpression.FormCalcAreaWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculated area"
        Height="560"
        Width="420"
        MinWidth="380"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.AreaSchedule;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

    <Grid Grid.Row="2" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,16">
            <StackPanel>
                <Border x:Name="gpbLength" Style="{StaticResource Weave.SectionPanel}">
                    <StackPanel>
                        <TextBlock x:Name="lblLengthSection" Style="{StaticResource Weave.SectionTitle}" Text="Length rounding"/>

                        <TextBlock x:Name="lblUnit" Style="{StaticResource Weave.BodyText}" Text="Project Units:" Margin="0,0,0,8"/>
                        <RadioButton x:Name="rdbLengthProject"
                                     Style="{StaticResource Weave.RadioButton.Stacked}"
                                     GroupName="LengthUnit"
                                     Content="Feet (ft)"/>
                        <RadioButton x:Name="rdbLengthMeters"
                                     Style="{StaticResource Weave.RadioButton.Stacked}"
                                     GroupName="LengthUnit"
                                     Margin="0,0,0,16"
                                     Content="Inch (in)"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock x:Name="lblLengthDecimal" Style="{StaticResource Weave.BodyText}" Text="Decimals" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtLengthDecimal" Style="{StaticResource Weave.TextBox}" Width="56" TextAlignment="Right"/>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource Weave.RoundingPanel}">
                                <StackPanel>
                                    <TextBlock x:Name="lblLengthOrder" Style="{StaticResource Weave.SectionTitle}" Text="Order" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="rdbLengthCut" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="LengthRounding" Content="Cutoff"/>
                                    <RadioButton x:Name="rdbLengthClose" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="LengthRounding" Content="Round Up"/>
                                    <RadioButton x:Name="rdbLengthRounding" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="LengthRounding" Margin="0" Content="Round Off"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button x:Name="btnLengthDefault" Style="{StaticResource Weave.Button.Tertiary}" Content="Default" HorizontalAlignment="Left">
                            <Button.InputBindings>
                                <KeyBinding Key="B" Modifiers="Alt" Command="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Command}"/>
                            </Button.InputBindings>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="gpbArea" Style="{StaticResource Weave.SectionPanel}">
                    <StackPanel>
                        <TextBlock x:Name="lblAreaSection" Style="{StaticResource Weave.SectionTitle}" Text="Area rounding"/>
                        <TextBlock x:Name="lblAreaUnitNote" Style="{StaticResource Weave.HintText}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock x:Name="lblAreaDecimal" Style="{StaticResource Weave.BodyText}" Text="Decimals" Margin="0,0,8,0"/>
                                <TextBox x:Name="txtAreaDecimal" Style="{StaticResource Weave.TextBox}" Width="56" TextAlignment="Right"/>
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource Weave.RoundingPanel}">
                                <StackPanel>
                                    <TextBlock x:Name="lblAreaOrder" Style="{StaticResource Weave.SectionTitle}" Text="Order" Margin="0,0,0,8"/>
                                    <RadioButton x:Name="rdbAreaCut" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaRounding" Content="Cutoff"/>
                                    <RadioButton x:Name="rdbAreaClose" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaRounding" Content="Round Up"/>
                                    <RadioButton x:Name="rdbAreaRounding" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaRounding" Margin="0" Content="Round Off"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Button x:Name="btnAreaDefault" Style="{StaticResource Weave.Button.Tertiary}" Content="Default" HorizontalAlignment="Left">
                            <Button.InputBindings>
                                <KeyBinding Key="F" Modifiers="Alt" Command="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Command}"/>
                            </Button.InputBindings>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="gpbPi" Style="{StaticResource Weave.SectionPanel}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="lblPiSection" Style="{StaticResource Weave.SectionTitle}" Text="Pi (π)"/>
                        <ComboBox x:Name="cboPi" Style="{StaticResource Weave.ComboBox}" Width="120" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Style="{StaticResource Weave.Button.Primary}" Content="OK" Margin="0,0,8,0"/>
            <Button x:Name="btnCancel" Style="{StaticResource Weave.Button.Secondary}" Content="Cancel (_C)">
                <Button.InputBindings>
                    <KeyBinding Key="C" Modifiers="Alt" Command="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Command}"/>
                </Button.InputBindings>
            </Button>
        </StackPanel>
    </Grid>
        </Grid>
    </Border>
</Window>
