<Window x:Class="ADSK.JExtRAC.AreaSchedule.Utils.WeaveProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing"
        Width="480"
        MinWidth="440"
        MaxWidth="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.AreaSchedule;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,20,0"/>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <StackPanel Grid.Row="2" Margin="20,16,20,20">
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource Weave.BodyText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <ProgressBar x:Name="OperationProgress"
                             Style="{StaticResource Weave.ProgressBar}"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource Weave.HintText}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
