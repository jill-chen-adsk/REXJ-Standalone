<Window x:Class="ADSK.JExtRAC.AreaSchedule.Utils.WeaveMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Information"
        Width="440"
        MinWidth="360"
        MaxWidth="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.AreaSchedule;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <TextBlock x:Name="MessageText"
                       Grid.Row="2"
                       Style="{StaticResource Weave.BodyText}"
                       TextWrapping="Wrap"
                       Margin="24,16,24,0"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,20,24,24">
                <Button x:Name="btnOK"
                        Style="{StaticResource Weave.Button.Primary}"
                        Content="OK"
                        MinWidth="88"
                        IsDefault="True"
                        Click="BtnOK_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
