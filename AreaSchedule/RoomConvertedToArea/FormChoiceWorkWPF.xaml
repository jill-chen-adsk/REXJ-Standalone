<Window x:Class="ADSK.JExtRAC.AreaSchedule.RoomConvertedToArea.FormChoiceWorkWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select task"
        Height="320"
        Width="560"
        MinWidth="520"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.AreaSchedule;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#20000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

    <Grid Grid.Row="2" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="gpbAreaCalc" Grid.Column="0" Style="{StaticResource Weave.SectionPanel}" Margin="0">
                <StackPanel>
                    <TextBlock x:Name="lblAreaCalcSection" Style="{StaticResource Weave.SectionTitle}" Text="Area calculation"/>
                    <RadioButton x:Name="rdbWallFinish" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaCalc" Content="Wall finish face"/>
                    <RadioButton x:Name="rdbWallCenter" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaCalc" Content="Wall centerline"/>
                    <RadioButton x:Name="rdbWallCoreLayer" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaCalc" Content="Wall structural face"/>
                    <RadioButton x:Name="rdbWallCoreCenter" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="AreaCalc" Content="Wall structural core center"/>
                </StackPanel>
            </Border>

            <Border x:Name="gpbTag" Grid.Column="2" Style="{StaticResource Weave.SectionPanel}" Margin="0">
                <StackPanel>
                    <CheckBox x:Name="chkAddAreaTag" Style="{StaticResource Weave.CheckBox}" Content="Add area tag"/>

                    <TextBlock x:Name="lblTag" Style="{StaticResource Weave.BodyText}" Text="Tag" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cboTag" Style="{StaticResource Weave.ComboBox}" Margin="0,0,0,12"/>

                    <Border Style="{StaticResource Weave.RoundingPanel}" Margin="0">
                        <StackPanel>
                            <TextBlock x:Name="lblTagNameSection" Style="{StaticResource Weave.SectionTitle}" Text="Name" Margin="0,0,0,8"/>
                            <RadioButton x:Name="rdbUseRoomName" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="TagName" Content="Use room name"/>
                            <RadioButton x:Name="rdbUseRoomNo" Style="{StaticResource Weave.RadioButton.Stacked}" GroupName="TagName" Content="Use room number"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <CheckBox x:Name="chkConvertArea"
                  Grid.Row="0"
                  Visibility="Collapsed"
                  Checked="ChkConvertArea_CheckedChanged"
                  Unchecked="ChkConvertArea_CheckedChanged"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Style="{StaticResource Weave.Button.Primary}" Content="OK" Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="btnCancel" Style="{StaticResource Weave.Button.Secondary}" Content="Cancel" IsCancel="True">
                <Button.InputBindings>
                    <KeyBinding Key="C" Modifiers="Alt" Command="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Command}"/>
                </Button.InputBindings>
            </Button>
        </StackPanel>
    </Grid>
        </Grid>
    </Border>
</Window>
