<Window x:Class="ADSK.JExtRAC.FloorHeightDimension.UI.FormConfigWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormConfig"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.FloorHeightDimension;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           Style="{StaticResource Weave.TitleText}"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{DynamicResource Weave.Brush.Chrome.CloseHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <Grid Grid.Row="2" Margin="24" MinWidth="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lblType"
                               Grid.Column="0"
                               Style="{StaticResource Weave.BodyText}"
                               Margin="0,0,12,0"/>
                    <ComboBox x:Name="cbDimensionType"
                              Grid.Column="1"
                              Style="{StaticResource Weave.ComboBox}"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Weave.GroupPanel}">
                    <StackPanel>
                        <TextBlock x:Name="gpbDist" Style="{StaticResource Weave.SectionTitle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="lblDist"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Style="{StaticResource Weave.BodyText}"
                                       Margin="0,0,12,8"/>
                            <TextBox x:Name="txtDist"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Style="{StaticResource Weave.TextBox}"
                                     TextAlignment="Right"
                                     Margin="0,0,8,8"/>
                            <TextBlock x:Name="lblDistUnit"
                                       Grid.Row="0"
                                       Grid.Column="2"
                                       Style="{StaticResource Weave.BodyText}"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="lblTotalDist"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Style="{StaticResource Weave.BodyText}"
                                       Margin="0,0,12,0"/>
                            <TextBox x:Name="txtTotalDist"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Style="{StaticResource Weave.TextBox}"
                                     TextAlignment="Right"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblTotalDistUnit"
                                       Grid.Row="1"
                                       Grid.Column="2"
                                       Style="{StaticResource Weave.BodyText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource Weave.SectionPanel}"
                        Margin="0,0,0,12"
                        Padding="12">
                    <Viewbox x:Name="diagramVector"
                             Width="300"
                             Height="196"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>

                <Button x:Name="btnSelPos"
                        Grid.Row="3"
                        Style="{StaticResource Weave.Button.Secondary}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Click="BtnSelPos_Click"/>

                <CheckBox x:Name="ckbMultiView"
                          Grid.Row="4"
                          Style="{StaticResource Weave.CheckBox}"
                          Margin="0,0,0,16"/>

                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnOK"
                            Style="{StaticResource Weave.Button.Primary}"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="BtnOK_Click"/>
                    <Button x:Name="btnCancel"
                            Style="{StaticResource Weave.Button.Secondary}"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
