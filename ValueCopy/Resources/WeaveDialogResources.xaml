<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Weave.Color.Text.Primary">#3C3C3C</Color>
    <Color x:Key="Weave.Color.Text.Secondary">#6B6B6B</Color>
    <Color x:Key="Weave.Color.Border">#D9D9D9</Color>
    <Color x:Key="Weave.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Weave.Color.Surface.Subtle">#F5F5F5</Color>
    <Color x:Key="Weave.Color.Input">#FFFFFF</Color>
    <Color x:Key="Weave.Color.Accent">#0696D7</Color>
    <Color x:Key="Weave.Color.Accent.Hover">#0586C1</Color>
    <Color x:Key="Weave.Color.Error">#E34850</Color>
    <Color x:Key="Weave.Color.Shadow">#000000</Color>

    <SolidColorBrush x:Key="Weave.Brush.Chrome.CloseHover" Color="#20000000"/>

    <SolidColorBrush x:Key="Weave.Brush.Text.Primary" Color="{DynamicResource Weave.Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Weave.Brush.Text.Secondary" Color="{DynamicResource Weave.Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Weave.Brush.Border" Color="{DynamicResource Weave.Color.Border}"/>
    <SolidColorBrush x:Key="Weave.Brush.Surface" Color="{DynamicResource Weave.Color.Surface}"/>
    <SolidColorBrush x:Key="Weave.Brush.Surface.Subtle" Color="{DynamicResource Weave.Color.Surface.Subtle}"/>
    <SolidColorBrush x:Key="Weave.Brush.Input" Color="{DynamicResource Weave.Color.Input}"/>
    <SolidColorBrush x:Key="Weave.Brush.Accent" Color="{StaticResource Weave.Color.Accent}"/>
    <SolidColorBrush x:Key="Weave.Brush.Accent.Hover" Color="{StaticResource Weave.Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Weave.Brush.Error" Color="{StaticResource Weave.Color.Error}"/>

    <Style x:Key="Weave.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Weave.ChromeWindow" TargetType="Window" BasedOn="{StaticResource Weave.Window}">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="Weave.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Weave.BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Weave.HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Weave.ColumnHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <SolidColorBrush x:Key="Weave.Brush.Error.Glyph" Color="#FFFFFF"/>

    <Style x:Key="Weave.ErrorMessage" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="Weave.ErrorIcon" TargetType="Control">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="DockPanel.Dock" Value="Left"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Ellipse Fill="{DynamicResource Weave.Brush.Error}"/>
                        <Path Fill="{DynamicResource Weave.Brush.Error.Glyph}"
                              Data="M6,3 H8 V8.5 H6 Z M6,10 H8 V12 H6 Z"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Weave.ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Weave.SectionPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style x:Key="Weave.TableHeaderPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface.Subtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style x:Key="Weave.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Weave.Button.Primary" TargetType="Button">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Weave.Brush.Accent.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Weave.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Weave.Button.Primary}">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface.Subtle}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Weave.Button.Tertiary" TargetType="Button" BasedOn="{StaticResource Weave.Button.Secondary}">
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="Weave.ListView" TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="Weave.ListViewItem" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="rowBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="rowBorder"
                                    Property="Background"
                                    Value="{DynamicResource Weave.Brush.Surface.Subtle}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Weave.DataGridRow" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Weave.Brush.Accent}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Weave.DataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface.Subtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="Weave.DataGridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Weave.DataGridTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,6"/>
    </Style>

    <Style x:Key="Weave.DataGridTextBlock.Center" TargetType="TextBlock" BasedOn="{StaticResource Weave.DataGridTextBlock}">
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Weave.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowBackground" Value="{DynamicResource Weave.Brush.Surface}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Weave.Brush.Surface.Subtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="RowStyle" Value="{StaticResource Weave.DataGridRow}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Weave.DataGridColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource Weave.DataGridCell}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <Style x:Key="Weave.RichTextBox" TargetType="RichTextBox">
        <Setter Property="Background" Value="{DynamicResource Weave.Brush.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Weave.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Weave.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

</ResourceDictionary>
