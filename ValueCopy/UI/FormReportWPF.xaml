<Window x:Class="ADSK.JExtRAC.ValueCopy.UI.FormReportWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormReport"
        Height="480"
        Width="820"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ADSK.JExtRAC.ValueCopy;component/Resources/WeaveDialogResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="chromeOuterBorder" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Color="{DynamicResource Weave.Color.Shadow}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="chromeTitleBar" Grid.Row="0">
                <TextBlock x:Name="chromeTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,48,0"/>
                <Button x:Name="chromeCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                <Path Data="M18,6 L6,18 M6,6 L18,18"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="2"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd"
                                            Property="Background"
                                            Value="{DynamicResource Weave.Brush.Chrome.CloseHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="chromeDivider" Grid.Row="1"/>

            <Grid Grid.Row="2" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgvLogData"
                          Grid.Row="0"
                          Style="{StaticResource Weave.DataGrid}"
                          AutoGenerateColumns="False"
                          CanUserResizeColumns="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="dgvLog_ElementId"
                                            Header="dgvLog_ElementId"
                                            Width="Auto"
                                            MinWidth="96"
                                            ElementStyle="{StaticResource Weave.DataGridTextBlock}"
                                            Binding="{Binding ElementId}"/>
                        <DataGridTextColumn x:Name="dgvLog_FamilyName"
                                            Header="dgvLog_FamilyName"
                                            Width="*"
                                            ElementStyle="{StaticResource Weave.DataGridTextBlock}"
                                            Binding="{Binding FamilyName}"/>
                        <DataGridTextColumn x:Name="dgvLog_TypeName"
                                            Header="dgvLog_TypeName"
                                            Width="*"
                                            ElementStyle="{StaticResource Weave.DataGridTextBlock}"
                                            Binding="{Binding TypeName}"/>
                        <DataGridTextColumn x:Name="dgvLog_ParameterName"
                                            Header="dgvLog_ParameterName"
                                            Width="*"
                                            ElementStyle="{StaticResource Weave.DataGridTextBlock}"
                                            Binding="{Binding ParameterName}"/>
                        <DataGridTextColumn x:Name="dgvLog_IconStatus"
                                            Header="dgvLog_IconStatus"
                                            Width="64"
                                            ElementStyle="{StaticResource Weave.DataGridTextBlock.Center}"
                                            Binding="{Binding IconStatus}"/>
                        <DataGridTextColumn x:Name="dgvLog_Status"
                                            Header="dgvLog_Status"
                                            Width="*"
                                            ElementStyle="{StaticResource Weave.DataGridTextBlock}"
                                            Binding="{Binding Status}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btShowLog"
                            Grid.Column="0"
                            Style="{StaticResource Weave.Button.Secondary}"
                            MinWidth="128"/>

                    <Button x:Name="btOK"
                            Grid.Column="2"
                            Style="{StaticResource Weave.Button.Primary}"
                            IsDefault="True"
                            Click="btOK_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
