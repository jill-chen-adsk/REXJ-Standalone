<Window x:Class="ADSK.JExtRAC.ValueCopy.UI.FormReportWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FormReport" Height="400" Width="Auto"
        WindowStartupLocation="CenterScreen"
        MinWidth="640" MinHeight="400">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgvLogData" 
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="dgvLog_ElementId" 
                                  Header="dgvLog_ElementId" 
                                  Width="Auto"
                                  Binding="{Binding ElementId}"/>
                <DataGridTextColumn x:Name="dgvLog_FamilyName" 
                                  Header="dgvLog_FamilyName" 
                                  Width="*"
                                  Binding="{Binding FamilyName}"/>
                <DataGridTextColumn x:Name="dgvLog_TypeName" 
                                  Header="dgvLog_TypeName" 
                                  Width="*"
                                  Binding="{Binding TypeName}"/>
                <DataGridTextColumn x:Name="dgvLog_ParameterName" 
                                  Header="dgvLog_ParameterName" 
                                  Width="*"
                                  Binding="{Binding ParameterName}"/>
                <DataGridTextColumn x:Name="dgvLog_IconStatus" 
                                  Header="dgvLog_IconStatus" 
                                  Width="40"
                                  Binding="{Binding IconStatus}"/>
                <DataGridTextColumn x:Name="dgvLog_Status" 
                                  Header="dgvLog_Status" 
                                  Width="*"
                                  Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="btShowLog" 
                    Grid.Column="0"
                    Content="btShowLog" 
                    Width="88" 
                    Height="23"/>
            
            <Button x:Name="btOK" 
                    Grid.Column="2"
                    Content="btOK" 
                    Width="75" 
                    Height="23"
                    IsDefault="True"
                    Click="btOK_Click"/>
        </Grid>
    </Grid>
</Window> 