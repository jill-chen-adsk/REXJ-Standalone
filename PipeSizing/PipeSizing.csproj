<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PipeSizing</RootNamespace>
    <AssemblyName>PipeSizing</AssemblyName>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>REVIT2027</DefineConstants>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ExtApp.cs" />
    <Compile Include="CmdPipeSizing.cs" />
    <Compile Include="CmdEditDefSystem.cs" />
    <Compile Include="CmdShowManual.cs" />
    <Compile Include="Components\Attribute.cs" />
    <Compile Include="Components\UI.cs" />
    <Compile Include="Components\Elements.cs" />
    <Compile Include="Components\Geometry.cs" />
    <Compile Include="Components\Parameters.cs" />
    <Compile Include="Components\Service.cs" />
    <Compile Include="Components\Settings.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Text.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Image.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\PipeSizing\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\MEP_PipeSizing_Manual.pdf" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Resources\MEP_PipeSizing_Manual.pdf')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PipeSizing.addin" />
  </ItemGroup>
</Project>
